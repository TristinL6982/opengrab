async function loadSettings() {
  try {
    const s = await api("/api/settings");
    // Remove the code that copies api_token into S.token since it's no longer sent by the server
    for (const f of SET_FIELDS) {
      const el = $("#set-" + f);
      if (!el) continue;
      if (el.type === "checkbox") el.checked = !!s[f];
      else el.value = s[f] ?? "";
    }
    $("#set-confirm_delete").checked = !!s.confirm_delete;
    $("#clipboard-state").textContent = s.clipboard_monitor_enabled
      ? "Clipboard monitoring is on; new links wait here for your approval."
      : "Clipboard monitoring is off.";
    // Use S.token which is set from URL hash or local storage instead of settings.api_token (which isn't sent anymore)
    $("#token-display").textContent = S.token || "(local only)";
    $("#lan-url").textContent = s.api_host === "127.0.0.1"
      ? "http://<your-ip>:" + s.api_port + BASE_PATH + "/#token=" + S.token
      : "http://<your-ip>:" + s.api_port + BASE_PATH + "/#token=" + S.token;
    // Only allow the UI to update the token display when it's not set from the hash (no fallback)
    if (!S.token) {
      // If no token was found, we still want to set it once from api_token for non-hash setups
      // but since api_token is now omitted from settings it must be handled via #token from URL
    }
  } catch (e) {
    console.warn("Load settings failed", e);
  }
}