# Host port; container listens on 5678.
OPENGRAB_PORT=5678
# Optional URL prefix, e.g. /opengrab, for a correctly configured HTTPS proxy.
OPENGRAB_BASE_PATH=
TZ=UTC
# Remote access: 1 = allow plain HTTP from the LAN (token still required)
OPENGRAB_ALLOW_REMOTE_HTTP=0
# Comma-separated reverse proxies that terminate HTTPS, e.g. 172.18.0.1
OPENGRAB_TRUSTED_PROXIES=
